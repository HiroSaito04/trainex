# Copy to .env on the relay host and set real secrets. Do NOT commit .env.
NODE_ENV=production
RELAY_PORT=8787
# Browser Origin(s), comma separated. HTTPS production URL(s) only.
RELAY_ALLOWED_ORIGINS=https://your-trainex.vercel.app
# Provide tokens securely at runtime via a trusted backend; never embed in VITE_* variables.
RELAY_BROWSER_TOKENS=REPLACE_WITH_LONG_RANDOM_BROWSER_ACCESS_TOKEN
# JSON, token + pairing code are SERVER-SIDE (device token also in ESP32 private Secrets.h)
RELAY_DEVICES_JSON={"trainex-esp32-01":{"token":"REPLACE_WITH_LONG_RANDOM_DEVICE_TOKEN","pairingCode":"REPLACE_WITH_PAIRING_CODE"}}
RELAY_HEARTBEAT_TIMEOUT_MS=90000
