# Copy values into Railway Variables or local environment; do not commit .env.
NODE_ENV=production
RELAY_PORT=8787
# Change to your exact Vercel production origin.
RELAY_ALLOWED_ORIGINS=https://trainex-six.vercel.app,http://localhost:5173
# Set this to true only for a supervised prototype without browser-auth backend.
# The browser still needs the unique long pairing code.
RELAY_ALLOW_PAIR_CODE_BROWSER_AUTH=true
# For the stronger browser-token mode: set this AND set above to false.
RELAY_BROWSER_TOKENS=
# Generate a unique random token and pairing code (32+ characters each).
# Replace the placeholder credentials; use Railway Variables, NOT GitHub.
RELAY_DEVICES_JSON={"trainex-esp32-01":{"token":"842985c184c496c2eb5fa0056f254738e26318eca68456df","pairingCode":"b05353e5d6d96eb615ffb134e776fcccdd3d2bb18acd00b1"}}
RELAY_HEARTBEAT_TIMEOUT_MS=90000
